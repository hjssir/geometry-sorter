#!/bin/sh
# Block accidental direct pushes to main.
# Installed per-clone by:  pwsh -File tools/install-hooks.ps1
# (sets:  git config core.hooksPath .githooks)
# Intentional bypass:      ALLOW_MAIN_PUSH=1 git push ...
#
# Rationale: private repos on GitHub Free cannot enable server-side branch
# protection (HTTP 403). This local hook is the free fallback.

status=0
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      if [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
        echo "" >&2
        echo "[pre-push] BLOCKED: direct push to 'main' is not allowed." >&2
        echo "           Work on a branch and open a Pull Request instead:" >&2
        echo "             git switch -c feat/xxx" >&2
        echo "             git push -u origin HEAD" >&2
        echo "           Emergency bypass: ALLOW_MAIN_PUSH=1 git push ..." >&2
        echo "           See CONTRIBUTING.md for details." >&2
        status=1
      fi
      ;;
  esac
done
exit $status
